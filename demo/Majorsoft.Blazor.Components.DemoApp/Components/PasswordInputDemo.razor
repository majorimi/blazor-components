@using Majorsoft.Blazor.Components.Inputs

@* The PasswordInput CSS ships in the NuGet package; consumers link it once (e.g. in index.html / App.razor). *@
<link rel="stylesheet" href="_content/Majorsoft.Blazor.Components.Inputs/passwordInput.css" />

<h1>Password input</h1>
<p>
    Blazor <code>PasswordInput</code> component: a secret text input with a <strong>customizable mask character</strong>
    (dot, star, bullet, etc.), a <strong>customizable layout</strong> (CSS class hooks and custom reveal icons) and a
    reveal (<strong>eye</strong>) button that shows or hides the entered value. The real value is kept in C# and supports
    <code>@@bind-Value</code>; mid-string editing, paste and delete all work while masked.
    For usage see source code and docs on
    <a href="https://github.com/majorimi/blazor-components/blob/master/.github/docs/Inputs.md" target="_blank">Github</a>.
    <br /><NugetPackageInfo PackageName="Majorsoft.Blazor.Components.Inputs" />
</p>

<div class="container-fluid p-3 mb-3 border rounded">
    <h3>Default (dot mask + eye toggle)</h3>
    <p>Two-way bound with <code>@@bind-Value</code>. Click the eye to reveal/hide the secret.</p>

    <PasswordInput @bind-Value="_password" Placeholder="Enter your password" />

    <p class="mt-2">Entered value (read from <code>@@bind-Value</code>): <code>@(_password ?? "")</code></p>
</div>

<div class="container-fluid p-3 mb-3 border rounded">
    <h3>Customizable mask character</h3>
    <p>Pick the character used while the value is hidden.</p>

    <div class="row pb-2">
        <div class="col-12">
            <label class="mr-3">Mask character:
                <select @bind="_mask">
                    <option value="●">● dot</option>
                    <option value="•">• bullet</option>
                    <option value="*">* star</option>
                    <option value="#"># hash</option>
                    <option value="★">★ black star</option>
                </select>
            </label>
            <label class="mr-3">Reveal button: <input type="checkbox" @bind="_showReveal" /></label>
            <label class="mr-3">Disabled: <input type="checkbox" @bind="_disabled" /></label>
        </div>
    </div>

    <PasswordInput @bind-Value="_password2"
                   MaskCharacter="@(_mask[0])"
                   ShowRevealButton="_showReveal"
                   Disabled="_disabled"
                   MaxLength="20"
                   Placeholder="Max 20 chars" />
</div>

<div class="container-fluid p-3 mb-3 border rounded">
    <h3>Custom layout &amp; icons</h3>
    <p>
        Restyle via <code>Class</code>/<code>InputClass</code>/<code>RevealButtonClass</code> and swap the reveal
        button content via <code>ShowIconContent</code>/<code>HideIconContent</code>. Here we use text icons and a
        controlled <code>@@bind-ShowPassword</code>.
    </p>

    <PasswordInput @bind-Value="_password3"
                   @bind-ShowPassword="_revealed"
                   MaskCharacter="@('•')"
                   Placeholder="Custom reveal icons">
        <ShowIconContent>👁️</ShowIconContent>
        <HideIconContent>🙈</HideIconContent>
    </PasswordInput>

    <p class="mt-2">Revealed: <code>@_revealed</code></p>
</div>

@code {
    private string? _password;
    private string? _password2;
    private string? _password3;

    private string _mask = "*";
    private bool _showReveal = true;
    private bool _disabled = false;
    private bool _revealed = false;
}
