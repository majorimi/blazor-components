@using Majorsoft.Blazor.Components.Tooltips

@* Shared, sectioned formatting toolbar used by both MarkdownEditor and RichTextEditor. It only renders
   the button chrome and raises abstract EditorCommand values; each editor decides how to apply them. *@

<div class="bmde-toolbar @ToolbarClass" role="toolbar">
	@if (ShowHeadingSection)
	{
		<div class="bmde-section">
			@foreach (var btn in _headingButtons) { @RenderButton(btn) }
		</div>
	}
	@if (ShowTextStyleSection)
	{
		<div class="bmde-section">
			@foreach (var btn in _textStyleButtons) { @RenderButton(btn) }
		</div>
	}
	@if (ShowListSection)
	{
		<div class="bmde-section">
			@foreach (var btn in _listButtons) { @RenderButton(btn) }
		</div>
	}
	@if (ShowIndentSection)
	{
		<div class="bmde-section">
			@foreach (var btn in _indentButtons) { @RenderButton(btn) }
		</div>
	}
	@if (ShowBlockSection)
	{
		<div class="bmde-section">
			@foreach (var btn in _blockButtons) { @RenderButton(btn) }
		</div>
	}
	@if (ShowInsertSection)
	{
		<div class="bmde-section">
			@foreach (var btn in _insertButtons) { @RenderInsertButton(btn) }
		</div>
	}
	@if (CustomToolbarContent is not null)
	{
		<div class="bmde-section">
			@CustomToolbarContent
		</div>
	}
	@if (TrailingContent is not null)
	{
		<div class="bmde-section" style="margin-left:auto;">
			@TrailingContent
		</div>
	}
</div>

@code {
	//A toolbar button: visible face, optional CSS face class, Tooltip text and the command it raises.
	private readonly record struct ToolbarButton(string Face, string? FaceClass, string Tooltip, EditorCommand Command);

	/// <summary>Shows or hides the Headings section (H1, H2, H3). Default is true.</summary>
	[Parameter] public bool ShowHeadingSection { get; set; } = true;

	/// <summary>Shows or hides the Text style section (Bold, Italic, Underline, Strikethrough). Default is true.</summary>
	[Parameter] public bool ShowTextStyleSection { get; set; } = true;

	/// <summary>Shows or hides the Lists section (Bullet, Numbered, Task). Default is true.</summary>
	[Parameter] public bool ShowListSection { get; set; } = true;

	/// <summary>Shows or hides the Indentation section (Decrease / Increase indent). Default is true.</summary>
	[Parameter] public bool ShowIndentSection { get; set; } = true;

	/// <summary>Shows or hides the Blocks section (Quote, Inline code, Code block, Horizontal rule). Default is true.</summary>
	[Parameter] public bool ShowBlockSection { get; set; } = true;

	/// <summary>Shows or hides the Insert section (Link, Image, Table). Default is true.</summary>
	[Parameter] public bool ShowInsertSection { get; set; } = true;

	/// <summary>When true each toolbar button shows a Tooltip; otherwise a native <c>title</c> is used. Default is true.</summary>
	[Parameter] public bool ShowButtonTooltips { get; set; } = true;

	/// <summary>When true all command buttons are disabled. Default is false.</summary>
	[Parameter] public bool Disabled { get; set; }

	/// <summary>Optional extra toolbar content rendered as an additional section (e.g. custom buttons).</summary>
	[Parameter] public RenderFragment? CustomToolbarContent { get; set; }

	/// <summary>Optional content rendered as a trailing right-aligned section (e.g. an editor's view/mode switch).</summary>
	[Parameter] public RenderFragment? TrailingContent { get; set; }

	/// <summary>
	/// When provided, the Insert buttons (Link, Image, Table) become Popover triggers and this template
	/// renders the form shown in the Popover for the button's <see cref="EditorCommand"/>. When <c>null</c>
	/// the Insert buttons raise <see cref="OnCommand"/> like the others (used by the Markdown editor).
	/// </summary>
	[Parameter] public RenderFragment<InsertPopoverContext>? InsertPopoverTemplate { get; set; }

	/// <summary>Raised when an Insert Popover opens, so the host can snapshot the current selection.</summary>
	[Parameter] public EventCallback<EditorCommand> OnInsertPopoverOpen { get; set; }

	/// <summary>Custom CSS class(es) applied to the toolbar element.</summary>
	[Parameter] public string? ToolbarClass { get; set; }

	/// <summary>Raised when a formatting button is clicked, with the corresponding <see cref="EditorCommand"/>.</summary>
	[Parameter] public EventCallback<EditorCommand> OnCommand { get; set; }

	private readonly ToolbarButton[] _headingButtons =
	{
		new("H1", null, "Heading 1", EditorCommand.Heading1),
		new("H2", null, "Heading 2", EditorCommand.Heading2),
		new("H3", null, "Heading 3", EditorCommand.Heading3),
	};

	private readonly ToolbarButton[] _textStyleButtons =
	{
		new("B", "bmde-btn-bold", "Bold (Ctrl+B)", EditorCommand.Bold),
		new("I", "bmde-btn-italic", "Italic (Ctrl+I)", EditorCommand.Italic),
		new("U", "bmde-btn-underline", "Underline (Ctrl+U)", EditorCommand.Underline),
		new("S", "bmde-btn-strike", "Strikethrough", EditorCommand.Strikethrough),
	};

	private readonly ToolbarButton[] _listButtons =
	{
		new("•", null, "Bullet list", EditorCommand.BulletList),
		new("1.", null, "Numbered list", EditorCommand.NumberedList),
		new("☑", null, "Task list", EditorCommand.TaskList),
	};

	private readonly ToolbarButton[] _indentButtons =
	{
		new("⇤", null, "Decrease indent", EditorCommand.IndentDecrease),
		new("⇥", null, "Increase indent", EditorCommand.IndentIncrease),
	};

	private readonly ToolbarButton[] _blockButtons =
	{
		new("❝", null, "Blockquote", EditorCommand.Quote),
		new("</>", null, "Inline code", EditorCommand.InlineCode),
		new("{ }", null, "Code block", EditorCommand.CodeBlock),
		new("―", null, "Horizontal rule", EditorCommand.HorizontalRule),
	};

	private readonly ToolbarButton[] _insertButtons =
	{
		new("🔗", null, "Link", EditorCommand.Link),
		new("🖼", null, "Image", EditorCommand.Image),
		new("▦", null, "Table", EditorCommand.Table),
	};

	private RenderFragment RenderButton(ToolbarButton btn) => __builder =>
	{
		if (ShowButtonTooltips)
		{
			<Tooltip Text="@btn.Tooltip" Position="TooltipPositions.Bottom" DelayBeforeShow="400">
				<button type="button" class="bmde-btn @btn.FaceClass" tabindex="-1"
						@onmousedown:preventDefault="true"
						disabled="@Disabled" @onclick="() => InvokeCommandAsync(btn.Command)">@RenderFace(btn)</button>
			</Tooltip>
		}
		else
		{
			<button type="button" class="bmde-btn @btn.FaceClass" tabindex="-1" title="@btn.Tooltip"
					@onmousedown:preventDefault="true"
					disabled="@Disabled" @onclick="() => InvokeCommandAsync(btn.Command)">@RenderFace(btn)</button>
		}
	};

	//Renders an SVG glyph for the icon commands; text-based faces (B/I/U/S, H1-H3) keep their letters so
	//they stay instantly readable. Icons share viewBox/size for a consistent toolbar.
	private RenderFragment RenderFace(ToolbarButton btn) => btn.Command switch
	{
		EditorCommand.BulletList => @<svg class="bmde-icon" viewBox="0 0 16 16" aria-hidden="true"><circle cx="2.4" cy="4" r="1.2" fill="currentColor" /><circle cx="2.4" cy="8" r="1.2" fill="currentColor" /><circle cx="2.4" cy="12" r="1.2" fill="currentColor" /><rect x="5.5" y="3.3" width="9" height="1.4" rx="0.7" fill="currentColor" /><rect x="5.5" y="7.3" width="9" height="1.4" rx="0.7" fill="currentColor" /><rect x="5.5" y="11.3" width="9" height="1.4" rx="0.7" fill="currentColor" /></svg>,
		EditorCommand.NumberedList => @<svg class="bmde-icon" viewBox="0 0 16 16" aria-hidden="true"><rect x="5.5" y="3.3" width="9" height="1.4" rx="0.7" fill="currentColor" /><rect x="5.5" y="7.3" width="9" height="1.4" rx="0.7" fill="currentColor" /><rect x="5.5" y="11.3" width="9" height="1.4" rx="0.7" fill="currentColor" /><text x="0.6" y="5.7" font-size="5.2" font-family="sans-serif" fill="currentColor">1</text><text x="0.6" y="9.7" font-size="5.2" font-family="sans-serif" fill="currentColor">2</text><text x="0.6" y="13.7" font-size="5.2" font-family="sans-serif" fill="currentColor">3</text></svg>,
		EditorCommand.TaskList => @<svg class="bmde-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1.4" y="2.4" width="5.2" height="5.2" rx="1" /><path d="M2.4 5 3.7 6.3 6 3.6" /><line x1="9" y1="5" x2="14.6" y2="5" /><rect x="1.4" y="8.8" width="5.2" height="5.2" rx="1" /><line x1="9" y1="11.4" x2="14.6" y2="11.4" /></svg>,
		EditorCommand.IndentDecrease => @<svg class="bmde-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="6.5" y1="3.3" x2="14.5" y2="3.3" /><line x1="6.5" y1="8" x2="14.5" y2="8" /><line x1="6.5" y1="12.7" x2="14.5" y2="12.7" /><path d="M4 5.5 1.5 8 4 10.5" /></svg>,
		EditorCommand.IndentIncrease => @<svg class="bmde-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="6.5" y1="3.3" x2="14.5" y2="3.3" /><line x1="6.5" y1="8" x2="14.5" y2="8" /><line x1="6.5" y1="12.7" x2="14.5" y2="12.7" /><path d="M1.5 5.5 4 8 1.5 10.5" /></svg>,
		EditorCommand.Quote => @<svg class="bmde-icon" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M3.2 4.2c-1.2 0-2.2 1-2.2 2.2s1 2.2 2.2 2.2c0 1.2-1 2.2-2.2 2.2v1.4c2.4 0 4-2 4-4.4V6.4c0-1.2-1-2.2-1.8-2.2zm7.6 0c-1.2 0-2.2 1-2.2 2.2s1 2.2 2.2 2.2c0 1.2-1 2.2-2.2 2.2v1.4c2.4 0 4-2 4-4.4V6.4c0-1.2-1-2.2-1.8-2.2z" /></svg>,
		EditorCommand.InlineCode => @<svg class="bmde-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5.5 4 2 8l3.5 4" /><path d="M10.5 4 14 8l-3.5 4" /></svg>,
		EditorCommand.CodeBlock => @<svg class="bmde-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1.5" y="2.6" width="13" height="10.8" rx="1.6" /><path d="M6 6.2 4.2 8 6 9.8" /><path d="M10 6.2 11.8 8 10 9.8" /></svg>,
		EditorCommand.HorizontalRule => @<svg class="bmde-icon" viewBox="0 0 16 16" aria-hidden="true"><rect x="1.5" y="7.3" width="13" height="1.6" rx="0.8" fill="currentColor" /></svg>,
		EditorCommand.Link => @<svg class="bmde-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6.6 9.4 9.4 6.6" /><path d="M7.2 4.6 8.4 3.4a2.5 2.5 0 0 1 3.5 3.5L10.7 8.1" /><path d="M8.8 11.4 7.6 12.6a2.5 2.5 0 0 1-3.5-3.5L5.3 7.9" /></svg>,
		EditorCommand.Image => @<svg class="bmde-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1.5" y="2.6" width="13" height="10.8" rx="1.6" /><circle cx="5.4" cy="6" r="1.2" fill="currentColor" stroke="none" /><path d="M2.2 12 6 8.2l2.4 2.4 2.3-2.3 3.1 3.1" /></svg>,
		EditorCommand.Table => @<svg class="bmde-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round" aria-hidden="true"><rect x="1.5" y="2.6" width="13" height="10.8" rx="1.2" /><line x1="1.5" y1="6.2" x2="14.5" y2="6.2" /><line x1="1.5" y1="9.8" x2="14.5" y2="9.8" /><line x1="6" y1="2.6" x2="6" y2="13.4" /><line x1="10.5" y1="2.6" x2="10.5" y2="13.4" /></svg>,
		_ => @<span>@btn.Face</span>,
	};

	private async Task InvokeCommandAsync(EditorCommand command)
	{
		if (!Disabled && OnCommand.HasDelegate)
		{
			await OnCommand.InvokeAsync(command);
		}
	}

	//Only one Insert Popover is open at a time; this is the command whose Popover is currently shown.
	private EditorCommand? _openPopover;

	//Context handed to the host's InsertPopoverTemplate: which command to render a form for and a Close
	//callback the form can invoke (e.g. after Insert) to dismiss the Popover.
	public sealed record InsertPopoverContext(EditorCommand Command, EventCallback Close);

	//Renders an Insert button either as a Popover trigger (when a template is provided) or as a plain
	//command button (default), so the same toolbar serves both the RichText and Markdown editors.
	private RenderFragment RenderInsertButton(ToolbarButton btn) => __builder =>
	{
		if (InsertPopoverTemplate is null)
		{
			@RenderButton(btn)
			return;
		}

		<Popover Position="TooltipPositions.Bottom"
				 HeaderText="@btn.Tooltip"
				 PopoverClass="bmde-insert-popover"
				 IsOpen="_openPopover == btn.Command"
				 IsOpenChanged="open => OnPopoverToggleAsync(btn.Command, open)"
				 OnOpen="() => OnInsertPopoverOpen.InvokeAsync(btn.Command)">
			<ChildContent>
				<button type="button" class="bmde-btn @btn.FaceClass" tabindex="-1" title="@btn.Tooltip"
						@onmousedown:preventDefault="true"
						disabled="@Disabled">@RenderFace(btn)</button>
			</ChildContent>
			<PopoverContent>
				@InsertPopoverTemplate(new InsertPopoverContext(btn.Command,
					EventCallback.Factory.Create(this, () => ClosePopover(btn.Command))))
			</PopoverContent>
		</Popover>
	};

	private async Task OnPopoverToggleAsync(EditorCommand command, bool open)
	{
		if (open)
		{
			_openPopover = command;
		}
		else if (_openPopover == command)
		{
			_openPopover = null;
		}
		await Task.CompletedTask;
	}

	private void ClosePopover(EditorCommand command)
	{
		if (_openPopover == command)
		{
			_openPopover = null;
		}
	}
}
