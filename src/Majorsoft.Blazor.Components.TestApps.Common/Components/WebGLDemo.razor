@using Majorsoft.Blazor.Components.Canvas
@using Majorsoft.Blazor.Components.Canvas.WebGL

<h1>WebGL</h1>
<p>
    Blazor <code>WebGLCanvas</code> component: renders an HTML <code>&lt;canvas&gt;</code> element and exposes the
    <strong>WebGL/WebGL2 GPU rendering API</strong> to .NET code via JS interop: buffers, GLSL shaders, programs,
    uniforms, textures and draw calls with <strong>command batching</strong> and a <strong>render loop</strong>.
    For usage see source code and docs on
    <a href="https://github.com/majorimi/blazor-components/blob/master/.github/docs/Canvas.md" target="_blank">Github</a>.
    <br /><NugetPackageInfo PackageName="Majorsoft.Blazor.Components.Canvas" />
</p>

<div class="container-fluid p-3 mb-3 border rounded">
    <h3>Rotating triangle</h3>
    <p>
        Vertex + fragment shaders compiled with <code>CompileProgramAsync</code>, vertex data uploaded with
        <code>BufferDataAsync</code>, rotation driven by a <code>uniform</code> updated in the <code>OnFrame</code> render loop.
    </p>

    <div class="row pb-2">
        <div class="col-auto">
            Speed: <input type="range" min="0" max="40" @bind="_speedPercent" @bind:event="oninput" /> @(_speedPercent / 10.0)x
        </div>
        <div class="col-auto">
            Background: <input type="color" @bind="_background" />
        </div>
        <div class="col-auto">
            <button class="btn btn-primary btn-sm" @onclick="ToggleLoopAsync">@(_loopRunning ? "Stop" : "Start") render loop</button>
        </div>
    </div>

    <WebGLCanvas @ref="_triangleCanvas" Width="620" Height="300" Style="border: 1px solid #ccc; border-radius: 4px;"
                 OnContextCreated="TriangleReadyAsync" OnFrame="TriangleFrameAsync" />

    <div class="pt-2">
        Context: <strong>@_contextInfo</strong>
    </div>
</div>

<div class="container-fluid p-3 mb-3 border rounded">
    <h3>Fragment shader animation</h3>
    <p>
        Full screen quad where all the animation happens <strong>per pixel in the fragment shader</strong> on the GPU;
        .NET only updates the <code>uTime</code> uniform every frame.
    </p>

    <WebGLCanvas Width="620" Height="260" Style="border: 1px solid #ccc; border-radius: 4px;"
                 OnContextCreated="PlasmaReadyAsync" OnFrame="PlasmaFrameAsync" />
</div>

<div class="container-fluid p-3 mb-3 border rounded">
    <h3>Render to texture (framebuffer)</h3>
    <p>
        The animated triangle is rendered <strong>offscreen into a 256x256 texture</strong> via a
        <code>WebGLFramebuffer</code> (<code>FramebufferTexture2DAsync</code>), then the texture is sampled on a
        rotating quad drawn to the canvas. Attribute setups are recorded in <strong>vertex array objects</strong>.
        <code>ReadPixelsAsync</code> reads pixels back to .NET.
    </p>

    <div class="row pb-2">
        <div class="col-auto">
            <button class="btn btn-primary btn-sm" @onclick="ReadCenterPixelAsync">Read center pixel</button>
        </div>
        <div class="col-auto mt-1">
            Framebuffer status: <strong>@_fboStatus</strong> @(_centerPixel is null ? "" : $"| Center pixel RGBA: {_centerPixel}")
        </div>
    </div>

    <WebGLCanvas @ref="_rttCanvas" Width="620" Height="300" Style="border: 1px solid #ccc; border-radius: 4px;"
                 ContextAttributes="@(new WebGLContextAttributes { PreserveDrawingBuffer = true })"
                 OnContextCreated="RttReadyAsync" OnFrame="RttFrameAsync" />
</div>

<div class="container-fluid p-3 mb-3 border rounded">
    <h3>Instanced particles</h3>
    <p>
        <strong>@ParticleCount instances</strong> of one quad drawn with a <strong>single</strong>
        <code>DrawArraysInstancedAsync</code> call; per-instance position, color and phase come from an instance
        buffer with <code>VertexAttribDivisorAsync</code>, motion is computed on the GPU from the <code>uTime</code> uniform.
        On WebGL 1.0 instancing is automatically backed by the <code>ANGLE_instanced_arrays</code> extension.
    </p>

    <WebGLCanvas Width="620" Height="300" Style="border: 1px solid #ccc; border-radius: 4px;"
                 OnContextCreated="ParticlesReadyAsync" OnFrame="ParticlesFrameAsync" />
</div>

<div class="container-fluid p-3 mb-3 border rounded">
    <h3>Input capture (keyboard, mouse, gamepad, pointer lock)</h3>
    <p>
        <strong>Click the canvas</strong> to focus it (<code>TabIndex="0"</code>), then move the ship with
        <strong>WASD / arrows or a gamepad stick</strong> — it aims at the mouse, hold <strong>left button</strong> to boost.
        Input state is captured with <code>StartInputCaptureAsync</code> and delivered with every
        <code>OnFrame</code> callback (<code>args.Input</code>), no extra interop call.
    </p>

    <div class="row pb-2">
        <div class="col-auto">
            <button class="btn btn-primary btn-sm" @onclick="() => _gameCanvas.RequestPointerLockAsync()">Request pointer lock (Esc exits)</button>
        </div>
        <div class="col-auto mt-1">
            <span style="font-family: monospace;">@_inputHud</span>
        </div>
    </div>

    <WebGLCanvas @ref="_gameCanvas" Width="620" Height="300" TabIndex="0"
                 Style="border: 1px solid #ccc; border-radius: 4px; outline: none; cursor: crosshair;"
                 OnContextCreated="GameReadyAsync" OnFrame="GameFrameAsync" />
</div>

@code {
    //Rotating triangle
    private WebGLCanvas _triangleCanvas = default!;
    private WebGLContext? _gl;
    private WebGLUniformLocation? _uAngle;
    private double _angle;
    private int _speedPercent = 10;
    private string _background = "#101820";
    private bool _loopRunning = true;
    private string _contextInfo = "";

    private async Task TriangleReadyAsync(WebGLContext gl)
    {
        _gl = gl;

        var program = await gl.CompileProgramAsync(
@"attribute vec2 aPos;
attribute vec3 aColor;
uniform float uAngle;
varying vec3 vColor;
void main() {
	float c = cos(uAngle);
	float s = sin(uAngle);
	gl_Position = vec4(mat2(c, -s, s, c) * aPos, 0.0, 1.0);
	vColor = aColor;
}",
@"precision mediump float;
varying vec3 vColor;
void main() {
	gl_FragColor = vec4(vColor, 1.0);
}");

        var buffer = await gl.CreateBufferAsync();
        await gl.BindBufferAsync(GL.ARRAY_BUFFER, buffer);
        await gl.BufferDataAsync(GL.ARRAY_BUFFER, new float[]
        {
            //x, y, r, g, b
            0.0f,  0.7f, 1f, 0.2f, 0.2f,
            -0.7f, -0.6f, 0.2f, 1f, 0.2f,
            0.7f, -0.6f, 0.2f, 0.4f, 1f,
        }, GL.STATIC_DRAW);

        await gl.UseProgramAsync(program);

        var aPos = await gl.GetAttribLocationAsync(program, "aPos");
        var aColor = await gl.GetAttribLocationAsync(program, "aColor");
        _uAngle = await gl.GetUniformLocationAsync(program, "uAngle");

        await gl.EnableVertexAttribArrayAsync(aPos);
        await gl.VertexAttribPointerAsync(aPos, 2, GL.FLOAT, false, 5 * sizeof(float), 0);
        await gl.EnableVertexAttribArrayAsync(aColor);
        await gl.VertexAttribPointerAsync(aColor, 3, GL.FLOAT, false, 5 * sizeof(float), 2 * sizeof(float));

        var version = await gl.GetParameterAsync<string>(GL.VERSION);
        _contextInfo = $"{version} (WebGL2: {gl.IsWebGL2})";
        StateHasChanged();
    }

    private async Task TriangleFrameAsync(CanvasFrameEventArgs args)
    {
        if (_gl is null || _uAngle is null)
        {
            return;
        }

        _angle += args.DeltaTime * (_speedPercent / 10.0);
        var (r, g, b) = HexToRgb(_background);

        _gl.BeginBatch(); //Single JS interop call per frame.
        await _gl.UniformAsync(_uAngle, (float)_angle);
        await _gl.ClearColorAsync(r, g, b, 1f);
        await _gl.ClearAsync(GL.COLOR_BUFFER_BIT);
        await _gl.DrawArraysAsync(GL.TRIANGLES, 0, 3);
        await _gl.EndBatchAsync();
    }

    private async Task ToggleLoopAsync()
    {
        if (_loopRunning)
        {
            await _triangleCanvas.StopRenderLoopAsync();
        }
        else
        {
            await _triangleCanvas.StartRenderLoopAsync();
        }
        _loopRunning = !_loopRunning;
    }

    private static (float R, float G, float B) HexToRgb(string hex)
    {
        hex = hex.TrimStart('#');
        return (Convert.ToInt32(hex.Substring(0, 2), 16) / 255f,
            Convert.ToInt32(hex.Substring(2, 2), 16) / 255f,
            Convert.ToInt32(hex.Substring(4, 2), 16) / 255f);
    }

    //Plasma fragment shader
    private WebGLContext? _plasmaGl;
    private WebGLUniformLocation? _uTime;

    private async Task PlasmaReadyAsync(WebGLContext gl)
    {
        _plasmaGl = gl;

        var program = await gl.CompileProgramAsync(
@"attribute vec2 aPos;
void main() {
	gl_Position = vec4(aPos, 0.0, 1.0);
}",
@"precision mediump float;
uniform float uTime;
uniform vec2 uResolution;
void main() {
	vec2 uv = gl_FragCoord.xy / uResolution;
	float v = sin((uv.x * 10.0) + uTime)
		+ sin((uv.y * 8.0) - uTime * 0.7)
		+ sin((uv.x + uv.y) * 6.0 + uTime * 1.3);
	vec3 color = 0.5 + 0.5 * cos(v + vec3(0.0, 2.1, 4.2));
	gl_FragColor = vec4(color, 1.0);
}");

        var buffer = await gl.CreateBufferAsync();
        await gl.BindBufferAsync(GL.ARRAY_BUFFER, buffer);
        await gl.BufferDataAsync(GL.ARRAY_BUFFER, new float[] { -1, -1, 1, -1, -1, 1, 1, 1 }, GL.STATIC_DRAW);

        await gl.UseProgramAsync(program);
        var aPos = await gl.GetAttribLocationAsync(program, "aPos");
        await gl.EnableVertexAttribArrayAsync(aPos);
        await gl.VertexAttribPointerAsync(aPos, 2, GL.FLOAT, false, 0, 0);

        _uTime = await gl.GetUniformLocationAsync(program, "uTime");
        var uResolution = await gl.GetUniformLocationAsync(program, "uResolution");
        if (uResolution is not null)
        {
            await gl.UniformAsync(uResolution, 620f, 260f);
        }
    }

    private async Task PlasmaFrameAsync(CanvasFrameEventArgs args)
    {
        if (_plasmaGl is null || _uTime is null)
        {
            return;
        }

        _plasmaGl.BeginBatch();
        await _plasmaGl.UniformAsync(_uTime, (float)args.TotalTime);
        await _plasmaGl.DrawArraysAsync(GL.TRIANGLE_STRIP, 0, 4);
        await _plasmaGl.EndBatchAsync();
    }

    //Render to texture (framebuffer + VAOs + readPixels)
    private const int RttTextureSize = 256;
    private WebGLCanvas _rttCanvas = default!;
    private WebGLContext? _rttGl;
    private WebGLProgram? _rttSceneProgram;
    private WebGLProgram? _rttQuadProgram;
    private WebGLVertexArrayObject? _rttSceneVao;
    private WebGLVertexArrayObject? _rttQuadVao;
    private WebGLUniformLocation? _rttSceneAngle;
    private WebGLUniformLocation? _rttQuadAngle;
    private string _fboStatus = "";
    private string? _centerPixel;

    private async Task RttReadyAsync(WebGLContext gl)
    {
        _rttGl = gl;

        //Offscreen scene: the same rotating triangle.
        _rttSceneProgram = await gl.CompileProgramAsync(
@"attribute vec2 aPos;
attribute vec3 aColor;
uniform float uAngle;
varying vec3 vColor;
void main() {
	float c = cos(uAngle);
	float s = sin(uAngle);
	gl_Position = vec4(mat2(c, -s, s, c) * aPos, 0.0, 1.0);
	vColor = aColor;
}",
@"precision mediump float;
varying vec3 vColor;
void main() {
	gl_FragColor = vec4(vColor, 1.0);
}");

        _rttSceneVao = await gl.CreateVertexArrayAsync();
        await gl.BindVertexArrayAsync(_rttSceneVao);
        var sceneBuffer = await gl.CreateBufferAsync();
        await gl.BindBufferAsync(GL.ARRAY_BUFFER, sceneBuffer);
        await gl.BufferDataAsync(GL.ARRAY_BUFFER, new float[]
        {
            0.0f,  0.7f, 1f, 0.2f, 0.2f,
            -0.7f, -0.6f, 0.2f, 1f, 0.2f,
            0.7f, -0.6f, 0.2f, 0.4f, 1f,
        }, GL.STATIC_DRAW);
        var scenePos = await gl.GetAttribLocationAsync(_rttSceneProgram, "aPos");
        var sceneColor = await gl.GetAttribLocationAsync(_rttSceneProgram, "aColor");
        await gl.EnableVertexAttribArrayAsync(scenePos);
        await gl.VertexAttribPointerAsync(scenePos, 2, GL.FLOAT, false, 5 * sizeof(float), 0);
        await gl.EnableVertexAttribArrayAsync(sceneColor);
        await gl.VertexAttribPointerAsync(sceneColor, 3, GL.FLOAT, false, 5 * sizeof(float), 2 * sizeof(float));
        _rttSceneAngle = await gl.GetUniformLocationAsync(_rttSceneProgram, "uAngle");

        //Quad on the canvas sampling the offscreen texture.
        _rttQuadProgram = await gl.CompileProgramAsync(
@"attribute vec2 aPos;
attribute vec2 aUv;
uniform float uAngle;
varying vec2 vUv;
void main() {
	float c = cos(uAngle);
	float s = sin(uAngle);
	gl_Position = vec4(mat2(c, -s, s, c) * aPos * vec2(0.6, 1.24), 0.0, 1.0);
	vUv = aUv;
}",
@"precision mediump float;
uniform sampler2D uTexture;
varying vec2 vUv;
void main() {
	gl_FragColor = texture2D(uTexture, vUv);
}");

        _rttQuadVao = await gl.CreateVertexArrayAsync();
        await gl.BindVertexArrayAsync(_rttQuadVao);
        var quadBuffer = await gl.CreateBufferAsync();
        await gl.BindBufferAsync(GL.ARRAY_BUFFER, quadBuffer);
        await gl.BufferDataAsync(GL.ARRAY_BUFFER, new float[]
        {
            //x, y, u, v
            -0.7f, -0.7f, 0f, 0f,
            0.7f, -0.7f, 1f, 0f,
            -0.7f,  0.7f, 0f, 1f,
            0.7f,  0.7f, 1f, 1f,
        }, GL.STATIC_DRAW);
        var quadPos = await gl.GetAttribLocationAsync(_rttQuadProgram, "aPos");
        var quadUv = await gl.GetAttribLocationAsync(_rttQuadProgram, "aUv");
        await gl.EnableVertexAttribArrayAsync(quadPos);
        await gl.VertexAttribPointerAsync(quadPos, 2, GL.FLOAT, false, 4 * sizeof(float), 0);
        await gl.EnableVertexAttribArrayAsync(quadUv);
        await gl.VertexAttribPointerAsync(quadUv, 2, GL.FLOAT, false, 4 * sizeof(float), 2 * sizeof(float));
        await gl.BindVertexArrayAsync(null);
        _rttQuadAngle = await gl.GetUniformLocationAsync(_rttQuadProgram, "uAngle");

        //Render target: empty texture attached to a framebuffer.
        var texture = await gl.CreateTextureAsync();
        await gl.BindTextureAsync(GL.TEXTURE_2D, texture);
        await gl.TexImage2DAsync(GL.TEXTURE_2D, 0, GL.RGBA, RttTextureSize, RttTextureSize, GL.RGBA, GL.UNSIGNED_BYTE, null);
        await gl.TexParameteriAsync(GL.TEXTURE_2D, GL.TEXTURE_MIN_FILTER, GL.LINEAR);
        await gl.TexParameteriAsync(GL.TEXTURE_2D, GL.TEXTURE_MAG_FILTER, GL.LINEAR);
        await gl.TexParameteriAsync(GL.TEXTURE_2D, GL.TEXTURE_WRAP_S, GL.CLAMP_TO_EDGE);
        await gl.TexParameteriAsync(GL.TEXTURE_2D, GL.TEXTURE_WRAP_T, GL.CLAMP_TO_EDGE);

        var framebuffer = await gl.CreateFramebufferAsync();
        await gl.BindFramebufferAsync(GL.FRAMEBUFFER, framebuffer);
        await gl.FramebufferTexture2DAsync(GL.FRAMEBUFFER, GL.COLOR_ATTACHMENT0, GL.TEXTURE_2D, texture);
        var status = await gl.CheckFramebufferStatusAsync(GL.FRAMEBUFFER);
        _fboStatus = status == GL.FRAMEBUFFER_COMPLETE ? "FRAMEBUFFER_COMPLETE" : $"0x{status:X}";
        _rttFramebuffer = framebuffer;
        await gl.BindFramebufferAsync(GL.FRAMEBUFFER, null);
        StateHasChanged();
    }

    private WebGLFramebuffer? _rttFramebuffer;

    private async Task RttFrameAsync(CanvasFrameEventArgs args)
    {
        if (_rttGl is null || _rttFramebuffer is null)
        {
            return;
        }

        var gl = _rttGl;
        gl.BeginBatch();

        //Pass 1: triangle into the offscreen texture.
        await gl.BindFramebufferAsync(GL.FRAMEBUFFER, _rttFramebuffer);
        await gl.ViewportAsync(0, 0, RttTextureSize, RttTextureSize);
        await gl.ClearColorAsync(0.95f, 0.87f, 0.35f, 1f);
        await gl.ClearAsync(GL.COLOR_BUFFER_BIT);
        await gl.UseProgramAsync(_rttSceneProgram!);
        await gl.BindVertexArrayAsync(_rttSceneVao);
        await gl.UniformAsync(_rttSceneAngle!, (float)args.TotalTime * 2f);
        await gl.DrawArraysAsync(GL.TRIANGLES, 0, 3);

        //Pass 2: textured quad onto the canvas.
        await gl.BindFramebufferAsync(GL.FRAMEBUFFER, null);
        await gl.ViewportAsync(0, 0, 620, 300);
        await gl.ClearColorAsync(0.06f, 0.09f, 0.16f, 1f);
        await gl.ClearAsync(GL.COLOR_BUFFER_BIT);
        await gl.UseProgramAsync(_rttQuadProgram!);
        await gl.BindVertexArrayAsync(_rttQuadVao);
        await gl.UniformAsync(_rttQuadAngle!, (float)Math.Sin(args.TotalTime) * 0.35f);
        await gl.DrawArraysAsync(GL.TRIANGLE_STRIP, 0, 4);
        await gl.BindVertexArrayAsync(null);

        await gl.EndBatchAsync();
    }

    private async Task ReadCenterPixelAsync()
    {
        if (_rttGl is null)
        {
            return;
        }

        var pixel = await _rttGl.ReadPixelsAsync(310, 150, 1, 1);
        _centerPixel = $"({pixel[0]}, {pixel[1]}, {pixel[2]}, {pixel[3]})";
    }

    //Instanced particles
    private const int ParticleCount = 2000;
    private WebGLContext? _particlesGl;
    private WebGLUniformLocation? _particlesTime;

    private async Task ParticlesReadyAsync(WebGLContext gl)
    {
        _particlesGl = gl;

        var program = await gl.CompileProgramAsync(
@"attribute vec2 aPos;
attribute vec2 aOffset;
attribute vec3 aColor;
attribute float aPhase;
uniform float uTime;
varying vec3 vColor;
void main() {
	float t = uTime * 0.8 + aPhase * 6.28318;
	vec2 orbit = vec2(cos(t), sin(t)) * (0.03 + aPhase * 0.12);
	gl_Position = vec4(aPos * 0.012 + aOffset + orbit, 0.0, 1.0);
	vColor = aColor;
}",
@"precision mediump float;
varying vec3 vColor;
void main() {
	gl_FragColor = vec4(vColor, 1.0);
}");
        await gl.UseProgramAsync(program);

        //One quad, drawn ParticleCount times.
        var quadBuffer = await gl.CreateBufferAsync();
        await gl.BindBufferAsync(GL.ARRAY_BUFFER, quadBuffer);
        await gl.BufferDataAsync(GL.ARRAY_BUFFER, new float[] { -1, -1, 1, -1, -1, 1, 1, 1 }, GL.STATIC_DRAW);
        var aPos = await gl.GetAttribLocationAsync(program, "aPos");
        await gl.EnableVertexAttribArrayAsync(aPos);
        await gl.VertexAttribPointerAsync(aPos, 2, GL.FLOAT, false, 0, 0);

        //Per instance: offset (2), color (3), phase (1).
        var random = new Random(42);
        var instanceData = new float[ParticleCount * 6];
        for (var i = 0; i < ParticleCount; i++)
        {
            instanceData[(i * 6) + 0] = (float)((random.NextDouble() * 1.9) - 0.95);
            instanceData[(i * 6) + 1] = (float)((random.NextDouble() * 1.9) - 0.95);
            instanceData[(i * 6) + 2] = (float)random.NextDouble();
            instanceData[(i * 6) + 3] = (float)random.NextDouble();
            instanceData[(i * 6) + 4] = 1f;
            instanceData[(i * 6) + 5] = (float)random.NextDouble();
        }

        var instanceBuffer = await gl.CreateBufferAsync();
        await gl.BindBufferAsync(GL.ARRAY_BUFFER, instanceBuffer);
        await gl.BufferDataAsync(GL.ARRAY_BUFFER, instanceData, GL.STATIC_DRAW);

        var aOffset = await gl.GetAttribLocationAsync(program, "aOffset");
        var aColor = await gl.GetAttribLocationAsync(program, "aColor");
        var aPhase = await gl.GetAttribLocationAsync(program, "aPhase");
        await gl.EnableVertexAttribArrayAsync(aOffset);
        await gl.VertexAttribPointerAsync(aOffset, 2, GL.FLOAT, false, 6 * sizeof(float), 0);
        await gl.VertexAttribDivisorAsync(aOffset, 1);
        await gl.EnableVertexAttribArrayAsync(aColor);
        await gl.VertexAttribPointerAsync(aColor, 3, GL.FLOAT, false, 6 * sizeof(float), 2 * sizeof(float));
        await gl.VertexAttribDivisorAsync(aColor, 1);
        await gl.EnableVertexAttribArrayAsync(aPhase);
        await gl.VertexAttribPointerAsync(aPhase, 1, GL.FLOAT, false, 6 * sizeof(float), 5 * sizeof(float));
        await gl.VertexAttribDivisorAsync(aPhase, 1);

        _particlesTime = await gl.GetUniformLocationAsync(program, "uTime");
    }

    private async Task ParticlesFrameAsync(CanvasFrameEventArgs args)
    {
        if (_particlesGl is null || _particlesTime is null)
        {
            return;
        }

        var gl = _particlesGl;
        gl.BeginBatch();
        await gl.UniformAsync(_particlesTime, (float)args.TotalTime);
        await gl.ClearColorAsync(0.02f, 0.03f, 0.08f, 1f);
        await gl.ClearAsync(GL.COLOR_BUFFER_BIT);
        await gl.DrawArraysInstancedAsync(GL.TRIANGLE_STRIP, 0, 4, ParticleCount);
        await gl.EndBatchAsync();
    }

    //Input capture
    private WebGLCanvas _gameCanvas = default!;
    private WebGLContext? _gameGl;
    private WebGLUniformLocation? _gamePos;
    private WebGLUniformLocation? _gameAngle;
    private WebGLUniformLocation? _gameScale;
    private double _shipX, _shipY, _shipAngle;
    private string _inputHud = "Click the canvas and press WASD...";
    private int _hudFrame;

    private async Task GameReadyAsync(WebGLContext gl)
    {
        _gameGl = gl;

        var program = await gl.CompileProgramAsync(
@"attribute vec2 aPos;
attribute vec3 aColor;
uniform vec2 uPos;
uniform float uAngle;
uniform float uScale;
varying vec3 vColor;
void main() {
	float c = cos(uAngle);
	float s = sin(uAngle);
	gl_Position = vec4((mat2(c, -s, s, c) * aPos) * uScale + uPos, 0.0, 1.0);
	vColor = aColor;
}",
@"precision mediump float;
varying vec3 vColor;
void main() {
	gl_FragColor = vec4(vColor, 1.0);
}");
        await gl.UseProgramAsync(program);

        //Ship: triangle pointing to +X so uAngle can aim at the mouse directly.
        var buffer = await gl.CreateBufferAsync();
        await gl.BindBufferAsync(GL.ARRAY_BUFFER, buffer);
        await gl.BufferDataAsync(GL.ARRAY_BUFFER, new float[]
        {
            1.0f,  0.0f, 1f, 0.9f, 0.3f,
            -0.7f,  0.6f, 0.2f, 0.6f, 1f,
            -0.7f, -0.6f, 0.2f, 0.6f, 1f,
        }, GL.STATIC_DRAW);
        var aPos = await gl.GetAttribLocationAsync(program, "aPos");
        var aColor = await gl.GetAttribLocationAsync(program, "aColor");
        await gl.EnableVertexAttribArrayAsync(aPos);
        await gl.VertexAttribPointerAsync(aPos, 2, GL.FLOAT, false, 5 * sizeof(float), 0);
        await gl.EnableVertexAttribArrayAsync(aColor);
        await gl.VertexAttribPointerAsync(aColor, 3, GL.FLOAT, false, 5 * sizeof(float), 2 * sizeof(float));

        _gamePos = await gl.GetUniformLocationAsync(program, "uPos");
        _gameAngle = await gl.GetUniformLocationAsync(program, "uAngle");
        _gameScale = await gl.GetUniformLocationAsync(program, "uScale");

        await _gameCanvas.StartInputCaptureAsync();
    }

    private async Task GameFrameAsync(CanvasFrameEventArgs args)
    {
        if (_gameGl is null || args.Input is null)
        {
            return;
        }

        var input = args.Input;

        //Keyboard (physical key codes, layout independent) + gamepad left stick.
        var moveX = (input.IsKeyDown("KeyD") || input.IsKeyDown("ArrowRight") ? 1.0 : 0)
            - (input.IsKeyDown("KeyA") || input.IsKeyDown("ArrowLeft") ? 1.0 : 0);
        var moveY = (input.IsKeyDown("KeyW") || input.IsKeyDown("ArrowUp") ? 1.0 : 0)
            - (input.IsKeyDown("KeyS") || input.IsKeyDown("ArrowDown") ? 1.0 : 0);

        var gamepad = input.Gamepads.FirstOrDefault();
        if (gamepad is not null && gamepad.Axes.Length >= 2)
        {
            moveX += Math.Abs(gamepad.Axes[0]) > 0.15 ? gamepad.Axes[0] : 0;
            moveY -= Math.Abs(gamepad.Axes[1]) > 0.15 ? gamepad.Axes[1] : 0;
        }

        _shipX = Math.Clamp(_shipX + (moveX * args.DeltaTime * 1.2), -0.95, 0.95);
        _shipY = Math.Clamp(_shipY + (moveY * args.DeltaTime * 1.2), -0.9, 0.9);

        //Aim at the mouse; with pointer lock use accumulated relative movement instead.
        if (input.IsPointerLocked)
        {
            _shipAngle += input.MovementX * 0.01;
        }
        else
        {
            var mouseClipX = (input.MouseX / 620 * 2) - 1;
            var mouseClipY = 1 - (input.MouseY / 300 * 2);
            _shipAngle = Math.Atan2(mouseClipY - _shipY, (mouseClipX - _shipX) * (620.0 / 300));
        }

        var boost = input.IsButtonDown(0) || (gamepad?.IsPressed(0) ?? false);

        var gl = _gameGl;
        gl.BeginBatch();
        await gl.UniformAsync(_gamePos!, (float)_shipX, (float)_shipY);
        await gl.UniformAsync(_gameAngle!, (float)_shipAngle);
        await gl.UniformAsync(_gameScale!, boost ? 0.16f : 0.1f);
        await gl.ClearColorAsync(0.04f, 0.06f, 0.12f, 1f);
        await gl.ClearAsync(GL.COLOR_BUFFER_BIT);
        await gl.DrawArraysAsync(GL.TRIANGLES, 0, 3);
        await gl.EndBatchAsync();

        //HUD label throttled to ~6 updates/sec.
        if (++_hudFrame % 10 == 0)
        {
            _inputHud = $"keys: [{string.Join(",", input.Keys)}] | mouse: {input.MouseX:0},{input.MouseY:0} btns: [{string.Join(",", input.Buttons)}]"
                + $" | wheel: {input.WheelDelta:0} | locked: {input.IsPointerLocked} | gamepads: {input.Gamepads.Length}";
            StateHasChanged();
        }
    }
}
