<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Configurations>Debug;Release</Configurations>
    <nullable>enable</nullable>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
		<PackageId>Majorsoft.Blazor.Server.Logging.Console</PackageId>
		<Version>1.0.0.0</Version>
		<IsTrimmable>true</IsTrimmable>
		<TrimMode>full</TrimMode>
		<InvariantGlobalization>false</InvariantGlobalization>
		<Authors>Imre Toth</Authors>
		<Product>Majorsoft Blazor Components</Product>
		<Description>Blazor extension for logging to browser console. Important NOTE: only works for apps using Server Hosting Model! Part of Majorsoft Blazor library.</Description>
		<Copyright>©2021 Imre Toth</Copyright>
		<PackageLicenseExpression></PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/majorimi/blazor-components/blob/master/.github/docs/ServerHostedLogging.md</PackageProjectUrl>
    <PackageReadmeFile>ServerHostedLogging.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/majorimi/blazor-components</RepositoryUrl>
		<PackageIcon>blazor.components.png</PackageIcon>
		<RepositoryType>Git</RepositoryType>
		<PackageTags>.NET8 .NET9 .NET10 Blazor Server ConsoleLog</PackageTags>
		<PackageReleaseNotes>See Releases here: https://github.com/majorimi/blazor-components/releases </PackageReleaseNotes>
		<Title>Blazor Server Logging Console</Title>
		<PackageLicenseFile>License.txt</PackageLicenseFile>
		<Company>Majorsoft</Company>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
	</PropertyGroup>

	<ItemGroup>
		<Content Remove="bundleconfig.json" />
	</ItemGroup>

	<ItemGroup>
		<_ContentIncludedByDefault Remove="bundleconfig.json" />
	</ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'NET10.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.8" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'NET9.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="9.0.16" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'NET8.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="8.0.27" />
  </ItemGroup>

  <ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.SignalR" Version="1.2.10" />
		<PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.8" />
		<PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.8" />
	</ItemGroup>
  <PropertyGroup>
    <DocumentationFile>bin\$(Configuration)\$(TargetFramework)\$(AssemblyName).xml</DocumentationFile>
  </PropertyGroup>

	<ItemGroup>
	<None Include="..\..\.github\docs\ServerHostedLogging.md" Link="ServerHostedLogging.md">
    <Pack>True</Pack>
    <PackagePath></PackagePath>
  </None>
	<None Include="..\..\.github\Images\blazor.components.png">
		<Pack>True</Pack>
		<PackagePath></PackagePath>
	</None>
	<None Include="..\..\.github\License.txt">
		<Pack>True</Pack>
		<PackagePath></PackagePath>
	</None>
	<None Include="bundleconfig.json" />
	</ItemGroup>

</Project>
