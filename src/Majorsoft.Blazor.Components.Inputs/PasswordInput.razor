@inherits ComponentBase

@*
	Password/secret text input with a customizable mask character (e.g. '●', '*', '•'), a fully
	customizable layout (CSS classes + optional custom reveal icons) and a reveal (eye) button that
	toggles between the masked and the plain text. The real value is always kept in C#; the rendered
	<input> only ever shows either the masked representation or the plain value, never both.
*@

<div class="bpwd @(Disabled ? "bpwd-disabled" : null) @Class" style="@Style">
	<input @ref="_inputRef"
		   type="text"
		   class="bpwd-input @InputClass"
		   value="@DisplayValue"
		   placeholder="@Placeholder"
		   autocomplete="@AutoComplete"
		   spellcheck="false"
		   autocapitalize="off"
		   autocorrect="off"
		   disabled="@Disabled"
		   readonly="@ReadOnly"
		   maxlength="@(MaxLength > 0 ? MaxLength : null)"
		   @oninput="OnInputAsync"
		   @attributes="AdditionalAttributes" />

	@if (ShowRevealButton)
	{
		<button type="button"
				class="bpwd-reveal @RevealButtonClass"
				tabindex="-1"
				disabled="@Disabled"
				title="@(ShowPassword ? HideTitle : ShowTitle)"
				aria-label="@(ShowPassword ? HideTitle : ShowTitle)"
				aria-pressed="@(ShowPassword ? "true" : "false")"
				@onclick="ToggleVisibilityAsync">
			@if (ShowPassword)
			{
				if (HideIconContent is not null)
				{
					@HideIconContent
				}
				else
				{
					<svg class="bpwd-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24" />
						<line x1="1" y1="1" x2="23" y2="23" />
					</svg>
				}
			}
			else
			{
				if (ShowIconContent is not null)
				{
					@ShowIconContent
				}
				else
				{
					<svg class="bpwd-icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
						<circle cx="12" cy="12" r="3" />
					</svg>
				}
			}
		</button>
	}
</div>
