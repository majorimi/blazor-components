@typeparam TItem

@inject IJSRuntime _jsRuntime
@inject IDragDropStateService _dragDropState

@implements IAsyncDisposable

<div @ref="_element"
	 class="bdropzone @(_isDragOver ? "bdropzone-active" : null) @(_isDragOver && !_accepts ? "bdropzone-reject" : null) @(Disabled ? "bdropzone-disabled" : null) @Class"
	 style="@Style"
	 @ondragenter="OnDragEnterAsync"
	 @ondragenter:preventDefault="true"
	 @ondragover="OnDragOverAsync"
	 @ondragover:preventDefault="true"
	 @ondragleave="OnDragLeaveAsync"
	 @ondrop="OnDropAsync"
	 @ondrop:preventDefault="true"
	 @attributes="AdditionalAttributes">

	@ChildContent
</div>

@code {
	private ElementReference _element;
	private IJSObjectReference? _jsModule;
	private string? _registeredOptions;
	private int _dragEnterCount;
	private bool _isDragOver;
	private bool _accepts = true;

	/// <summary>
	/// The content rendered inside the drop target element.
	/// </summary>
	[Parameter] public RenderFragment? ChildContent { get; set; }

	/// <summary>
	/// When true the drop target ignores drops. Default is false.
	/// </summary>
	[Parameter] public bool Disabled { get; set; }

	/// <summary>
	/// The feedback (cursor) shown by the browser while dragging over this target (HTML <c>dropEffect</c>). Default is <see cref="DropEffect.Move"/>.
	/// <para>
	/// <b>Advisory only.</b> Like the underlying HTML Drag and Drop API, this value is purely advisory: it controls the
	/// cursor the browser shows and takes part in <i>negotiation</i> (if it is not permitted by the drag source's
	/// <see cref="Draggable{TItem}.EffectAllowed"/> the browser forces it to <c>none</c> and the drop is suppressed).
	/// It does <b>not</b> make the component copy, move or link anything &mdash; the browser never performs the operation
	/// itself. The actual data change (e.g. relocating an item for <see cref="DropEffect.Move"/>, duplicating it for
	/// <see cref="DropEffect.Copy"/>, creating a reference for <see cref="DropEffect.Link"/>) must be implemented by the
	/// integrator in <see cref="OnItemDrop"/> / <see cref="OnDrop"/>. The browser-negotiated effect is available as
	/// <c>DragEventArgs.DataTransfer.DropEffect</c> on the <see cref="OnDrop"/> callback.
	/// </para>
	/// </summary>
	[Parameter] public DropEffect DropEffect { get; set; } = DropEffect.Move;

	/// <summary>
	/// Optional predicate evaluated against the currently dragged item to decide whether this zone accepts it.
	/// When it returns false the drop is ignored and the zone shows a "reject" style. Default (null) accepts anything.
	/// </summary>
	[Parameter] public Func<TItem?, bool>? AcceptCondition { get; set; }

	/// <summary>
	/// Fired when a dragged element enters the drop target (HTML <c>dragenter</c>).
	/// </summary>
	[Parameter] public EventCallback<DragEventArgs> OnDragEnter { get; set; }

	/// <summary>
	/// Fired continuously while a dragged element is over the drop target (HTML <c>dragover</c>).
	/// </summary>
	[Parameter] public EventCallback<DragEventArgs> OnDragOver { get; set; }

	/// <summary>
	/// Fired when a dragged element leaves the drop target (HTML <c>dragleave</c>).
	/// </summary>
	[Parameter] public EventCallback<DragEventArgs> OnDragLeave { get; set; }

	/// <summary>
	/// Fired when something is dropped on the target (HTML <c>drop</c>). Provides the raw <see cref="DragEventArgs"/>
	/// including access to <c>DataTransfer</c> (dropped files, items, types and effects).
	/// </summary>
	[Parameter] public EventCallback<DragEventArgs> OnDrop { get; set; }

	/// <summary>
	/// Fired when an accepted <c>Draggable</c> item is dropped on the target. Provides the strongly-typed payload.
	/// <para>
	/// This is where the integrator performs the actual operation implied by <see cref="DropEffect"/>: the component only
	/// negotiates the effect and the cursor, it does not copy/move/link anything itself. To branch on the
	/// browser-negotiated effect (rather than the configured <see cref="DropEffect"/>) read
	/// <c>DragEventArgs.DataTransfer.DropEffect</c> in <see cref="OnDrop"/>, which fires immediately before this callback.
	/// </para>
	/// </summary>
	[Parameter] public EventCallback<TItem?> OnItemDrop { get; set; }

	/// <summary>
	/// Custom CSS class(es) applied to the drop target element.
	/// </summary>
	[Parameter] public string? Class { get; set; }

	/// <summary>
	/// Custom inline style applied to the drop target element.
	/// </summary>
	[Parameter] public string? Style { get; set; }

	/// <summary>
	/// Arbitrary HTML attributes applied to the rendered drop target element.
	/// </summary>
	[Parameter(CaptureUnmatchedValues = true)]
	public Dictionary<string, object>? AdditionalAttributes { get; set; }

	/// <summary>
	/// Reference to the rendered drop target HTML element.
	/// </summary>
	public ElementReference Element => _element;

	/// <summary>
	/// Returns true while a dragged element is currently over this drop target.
	/// </summary>
	public bool IsDragOver => _isDragOver;

	private async Task OnDragEnterAsync(DragEventArgs e)
	{
		_dragEnterCount++;
		_isDragOver = true;
		_accepts = Accepts();

		if (OnDragEnter.HasDelegate)
		{
			await OnDragEnter.InvokeAsync(e);
		}
	}

	private async Task OnDragOverAsync(DragEventArgs e)
	{
		if (OnDragOver.HasDelegate)
		{
			await OnDragOver.InvokeAsync(e);
		}
	}

	private async Task OnDragLeaveAsync(DragEventArgs e)
	{
		_dragEnterCount--;
		if (_dragEnterCount <= 0)
		{
			_dragEnterCount = 0;
			_isDragOver = false;
		}

		if (OnDragLeave.HasDelegate)
		{
			await OnDragLeave.InvokeAsync(e);
		}
	}

	private async Task OnDropAsync(DragEventArgs e)
	{
		_dragEnterCount = 0;
		_isDragOver = false;

		var item = _dragDropState.GetActiveItem<TItem>();
		var accepted = !Disabled && (AcceptCondition is null || AcceptCondition(item));

		if (OnDrop.HasDelegate)
		{
			await OnDrop.InvokeAsync(e);
		}

		if (accepted && OnItemDrop.HasDelegate)
		{
			await OnItemDrop.InvokeAsync(item);
		}

		_dragDropState.Clear();
	}

	private bool Accepts()
	{
		if (Disabled)
		{
			return false;
		}

		if (AcceptCondition is null)
		{
			return true;
		}

		return AcceptCondition(_dragDropState.GetActiveItem<TItem>());
	}

	protected override void OnInitialized()
	{
		_dragDropState.ActiveItemChanged += OnActiveItemChanged;
	}

	//When a drag operation ends globally (item cleared) ensure this zone does not stay stuck in the
	//drag-over/reject state. The browser does not always fire 'dragleave' on the hovered zone when a drag
	//is cancelled (ESC) or dropped on another element, which would otherwise leave the highlight on.
	private void OnActiveItemChanged()
	{
		if (_dragDropState.HasActiveItem || (!_isDragOver && _dragEnterCount == 0))
		{
			return;
		}

		_dragEnterCount = 0;
		_isDragOver = false;
		_accepts = true;
		InvokeAsync(StateHasChanged);
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		await SyncJsRegistrationAsync();
	}

	//Applies the dropEffect to the live DataTransfer via a native dragover listener (managed handlers cannot write it).
	private async Task SyncJsRegistrationAsync()
	{
		var options = new DropZoneJsOptions { DropEffect = DropEffect.ToJsValue() };

		var key = $"{options.DropEffect}|{Disabled}";
		if (key == _registeredOptions)
		{
			return;
		}

		try
		{
			_jsModule ??= await _jsRuntime.InvokeAsync<IJSObjectReference>("import",
				"./_content/Majorsoft.Blazor.Components.DragAndDrop/dragDrop.js");

			if (Disabled)
			{
				await _jsModule.InvokeVoidAsync("unregisterDropZone", _element);
			}
			else
			{
				await _jsModule.InvokeVoidAsync("registerDropZone", _element, options);
			}

			_registeredOptions = key;
		}
		catch (JSDisconnectedException) { }
		catch (ObjectDisposedException) { }
	}

	public async ValueTask DisposeAsync()
	{
		_dragDropState.ActiveItemChanged -= OnActiveItemChanged;

		if (_jsModule is not null)
		{
			try
			{
				await _jsModule.InvokeVoidAsync("unregisterDropZone", _element);
				await _jsModule.DisposeAsync();
			}
			catch (JSDisconnectedException) { }
			catch (ObjectDisposedException) { }
		}
	}
}
