<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
	  <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
	  <nullable>enable</nullable>
	  <IsTrimmable>true</IsTrimmable>
	  <TrimMode>full</TrimMode>
	  <InvariantGlobalization>false</InvariantGlobalization>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageId>Majorsoft.Blazor.Components.Core</PackageId>
    <Configurations>Debug;Release</Configurations>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'NET10.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.8" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'NET9.0'">
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="9.0.16" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'NET8.0'">
	  <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="8.0.27" />
  </ItemGroup>

</Project>
