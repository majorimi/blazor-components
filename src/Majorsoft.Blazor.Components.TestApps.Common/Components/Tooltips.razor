<h1>Tooltip control</h1>
<p>
	Blazor component that renders a customizable Tooltip (Popover) for any element on hover or focus.
	It supports 4 positions, configurable show/hide delays, plain text or rich HTML content, an optional arrow,
	custom styling and show/hide events.
	For usage see source code and docs on
	<a href="https://github.com/majorimi/blazor-components/blob/master/.github/docs/Tooltips.md" target="_blank">Github</a>.
	<br /><NugetPackageInfo PackageName="Majorsoft.Blazor.Components.Tooltips" />
</p>

<div class="container-fluid p-3 mb-3 border rounded">
	<h3>Simple Tooltips</h3>
	<p>
		Wrap any content with the <code>&lt;Tooltip&gt;</code> component and set the <code>Text</code> parameter.
		Hover (or keyboard focus) the elements below to show the Tooltip.
	</p>

	<div class="row pb-2">
		<div class="col-12">
			<Tooltip Text="I am a simple text Tooltip.">
				<span class="font-weight-bold" style="border-bottom: 1px dotted #555; cursor: help;">Hover this text</span>
			</Tooltip>
			<span class="mx-3"></span>
			<Tooltip Text="Tooltips work on any element, e.g. buttons. Focus me with the Tab key too.">
				<button class="btn btn-primary">Hover or focus this button</button>
			</Tooltip>
			<span class="mx-3"></span>
			<Tooltip Text="Long Tooltip text wraps automatically once it reaches the maximum width so it stays readable.">
				<button class="btn btn-outline-secondary">Long text Tooltip</button>
			</Tooltip>
		</div>
	</div>
</div>

<div class="container-fluid p-3 mb-3 border rounded">
	<h3>Tooltip positions</h3>
	<p>
		Use the <code>Position</code> parameter to place the Tooltip <code>Top</code>, <code>Right</code>, <code>Bottom</code> or <code>Left</code> of the trigger element.
	</p>

	<div class="row pb-2 text-center" style="padding: 40px 0;">
		@foreach (var position in (TooltipPositions[])Enum.GetValues(typeof(TooltipPositions)))
		{
			<div class="col-3">
				<Tooltip Text="@($"Tooltip on the {position}.")" Position="position">
					<button class="btn btn-info">@position</button>
				</Tooltip>
			</div>
		}
	</div>
</div>

<div class="container-fluid p-3 mb-3 border rounded">
	<h3>Customizable Tooltip</h3>
	<p>
		Configure a Tooltip live: change its position, show/hide delays, arrow, disabled state and content.
	</p>

	<div class="row pb-2">
		<div class="col-12 col-lg-6">
			<div class="form-group">
				<label>Position:</label>
				<select class="form-control" @bind="_position">
					@foreach (var position in (TooltipPositions[])Enum.GetValues(typeof(TooltipPositions)))
					{
						<option value="@position">@position</option>
					}
				</select>
			</div>
			<div class="form-group">
				<label>Delay before show (ms):</label>
				<input type="number" min="0" step="50" class="form-control" @bind="_delayBeforeShow" />
			</div>
			<div class="form-group">
				<label>Delay before hide (ms):</label>
				<input type="number" min="0" step="50" class="form-control" @bind="_delayBeforeHide" />
			</div>
			<div class="form-group">
				<label>Tooltip text:</label>
				<input type="text" class="form-control" @bind="_text" />
			</div>
			<div>
				Show arrow: <input class="mr-3" type="checkbox" @bind="_showArrow" />
				Disabled: <input class="mr-3" type="checkbox" @bind="_disabled" />
				Rich content: <input class="mr-3" type="checkbox" @bind="_richContent" />
			</div>
		</div>
		<div class="col-12 col-lg-6 text-center" style="padding: 60px 0;">
			@if (_richContent)
			{
				<Tooltip Position="_position"
						 DelayBeforeShow="_delayBeforeShow"
						 DelayBeforeHide="_delayBeforeHide"
						 ShowArrow="_showArrow"
						 Disabled="_disabled"
						 OnShow="OnTooltipShow"
						 OnHide="OnTooltipHide">
					<ChildContent>
						<button class="btn btn-success">Hover me</button>
					</ChildContent>
					<TooltipContent>
						<div class="text-left">
							<strong>Rich Tooltip</strong>
							<hr class="my-1" style="border-color: #888;" />
							Tooltips can render any markup, e.g. an
							<span style="color: #ffd54f;">icon</span> &#9733; or a
							<a href="https://github.com/majorimi/blazor-components" target="_blank" style="color: #90caf9;">link</a>.
						</div>
					</TooltipContent>
				</Tooltip>
			}
			else
			{
				<Tooltip Text="@_text"
						 Position="_position"
						 DelayBeforeShow="_delayBeforeShow"
						 DelayBeforeHide="_delayBeforeHide"
						 ShowArrow="_showArrow"
						 Disabled="_disabled"
						 OnShow="OnTooltipShow"
						 OnHide="OnTooltipHide">
					<button class="btn btn-success">Hover me</button>
				</Tooltip>
			}
		</div>
	</div>

	<div class="row pb-2">
		<div class="col-12">
			<label><strong>Events log</strong>:</label>
			<textarea @ref="_log" @bind="_logMessage" class="form-control w-100 logText" readonly></textarea>
		</div>
	</div>
</div>

<div class="container-fluid p-3 mb-3 border rounded">
	<h3>Custom styled Tooltip</h3>
	<p>
		Use <code>TooltipClass</code> and <code>TooltipStyle</code> to override the Tooltip popup appearance, and
		<code>Class</code> / <code>Style</code> for the trigger container.
	</p>

	<div class="row pb-2" style="padding: 30px 0;">
		<div class="col-12">
			<Tooltip Text="Custom colored Tooltip with no arrow."
					 ShowArrow="false"
					 TooltipStyle="background-color: #6f42c1; color: #fff; font-weight: bold;">
				<button class="btn btn-outline-primary">Custom styled Tooltip</button>
			</Tooltip>
		</div>
	</div>
</div>

<div class="container-fluid p-3 mb-3 border rounded">
	<h3>Popover</h3>
	<p>
		The <code>&lt;Popover&gt;</code> component shows a click-triggered, anchored panel with an optional header, a
		<code>PopoverContent</code> body and programmatic open/close. It is meant to host richer content such as a color
		selector or a date picker.
	</p>

	<h5>Customizable Popover</h5>
	<p>Change the settings below and toggle the Popover to see the effect.</p>
	<div class="row pb-2">
		<div class="col-12 col-lg-6">
			<div class="form-group">
				<label>Position:</label>
				<select class="form-control" @bind="_popoverPosition">
					@foreach (var position in (TooltipPositions[])Enum.GetValues(typeof(TooltipPositions)))
					{
						<option value="@position">@position</option>
					}
				</select>
			</div>
			<div class="form-group">
				<label>Header text:</label>
				<input type="text" class="form-control" @bind="_popoverHeader" />
			</div>
			<div class="row">
				<div class="col-6">
					<label>Width (px, 0 = auto):</label>
					<input type="number" min="0" step="20" class="form-control" @bind="_popoverWidth" />
				</div>
				<div class="col-6">
					<label>Height (px, 0 = auto):</label>
					<input type="number" min="0" step="20" class="form-control" @bind="_popoverHeight" />
				</div>
			</div>
			<div class="mt-2">
				Show close button: <input class="mr-3" type="checkbox" @bind="_popoverShowClose" />
				Open on click: <input class="mr-3" type="checkbox" @bind="_popoverOpenOnClick" />
				Disabled: <input class="mr-3" type="checkbox" @bind="_popoverDisabled" />
			</div>
			<div>
				Close on outside click: <input class="mr-3" type="checkbox" @bind="_popoverCloseOutside" />
				Close on Esc: <input class="mr-3" type="checkbox" @bind="_popoverCloseEsc" />
			</div>
		</div>
		<div class="col-12 col-lg-6 text-center" style="padding: 40px 0;">
			<Popover @ref="_customPopover"
					 HeaderText="@_popoverHeader"
					 Position="_popoverPosition"
					 Width="_popoverWidth"
					 Height="_popoverHeight"
					 ShowCloseButton="_popoverShowClose"
					 OpenOnClick="_popoverOpenOnClick"
					 CloseOnOutsideClick="_popoverCloseOutside"
					 CloseOnEscapeKey="_popoverCloseEsc"
					 Disabled="_popoverDisabled"
					 OnOpen="OnPopoverOpen"
					 OnClose="OnPopoverClose">
				<ChildContent>
					<button class="btn btn-primary">Toggle Popover</button>
				</ChildContent>
				<PopoverContent>
					<p class="mb-0">
						Popovers can contain any HTML content. Click outside, press <kbd>Esc</kbd> or use the
						close button to dismiss (depending on the settings).
					</p>
				</PopoverContent>
			</Popover>
			<div class="mt-3">
				<button class="btn btn-sm btn-success mr-2" @onclick="@(() => _customPopover?.OpenAsync() ?? Task.CompletedTask)">Open</button>
				<button class="btn btn-sm btn-danger mr-2" @onclick="@(() => _customPopover?.CloseAsync() ?? Task.CompletedTask)">Close</button>
				<button class="btn btn-sm btn-secondary" @onclick="@(() => _customPopover?.ToggleAsync() ?? Task.CompletedTask)">Toggle</button>
			</div>
		</div>
	</div>

	<hr />

	<h5>Color selector Popover</h5>
	<p>
		Hosting a <code>ColorPalette</code> inside a Popover. The Popover stays open while picking and only closes on
		<strong>Apply</strong>, the close button or an outside click &mdash; it does not close on every color change.
	</p>
	<div class="row pb-2">
		<div class="col-12">
			<Popover @ref="_colorPopover" HeaderText="Pick a color" Position="TooltipPositions.Bottom" Width="340"
					 CloseOnOutsideClick="true" OnOpen="OnPopoverOpen" OnClose="OnPopoverClose">
				<ChildContent>
					<button class="btn btn-outline-secondary">
						<span style="display:inline-block; width:14px; height:14px; vertical-align:middle; border:1px solid #ccc; border-radius:3px; background:@_pickedColor.ToHtmlHex();"></span>
						@_pickedColor.ToHtmlHex()
					</button>
				</ChildContent>
				<PopoverContent>
					<ColorPalette SelectedColor="_pickedColor"
								  HueAreaWidth="300"
								  HueAreaHeight="180"
								  HueSliderWidth="300"
								  ShowInfoArea="false"
								  OnColorChanged="OnColorPicked" />
					<div class="text-right mt-2">
						<button class="btn btn-sm btn-primary" @onclick="CloseColorPopover">Apply</button>
					</div>
				</PopoverContent>
			</Popover>
		</div>
	</div>

	<div class="row pb-2">
		<div class="col-12">
			<label><strong>Events log</strong>:</label>
			<textarea @ref="_popoverLog" @bind="_popoverLogMessage" class="form-control w-100 logText" readonly></textarea>
		</div>
	</div>
</div>

@using System.Drawing
@using Majorsoft.Blazor.Components.Core.HtmlColors

@code {
	//Customizable example state
	private TooltipPositions _position = TooltipPositions.Top;
	private int _delayBeforeShow = 0;
	private int _delayBeforeHide = 250;
	private bool _showArrow = true;
	private bool _disabled = false;
	private bool _richContent = false;
	private string _text = "Customize me using the controls on the left!";

	private ElementReference _log;
	private string _logMessage = "";

	private async Task OnTooltipShow()
	{
		_logMessage += $"Tooltip shown ({_position}). {Environment.NewLine}";
		await _log.ScrollToEndAsync();
	}

	private async Task OnTooltipHide()
	{
		_logMessage += $"Tooltip hidden. {Environment.NewLine}";
		await _log.ScrollToEndAsync();
	}

	//Popover example state
	private Popover? _customPopover;
	private Popover? _colorPopover;
	private Color _pickedColor = Color.FromArgb(66, 135, 245);

	//Customizable Popover settings
	private TooltipPositions _popoverPosition = TooltipPositions.Bottom;
	private string _popoverHeader = "Popover header";
	private int _popoverWidth = 280;
	private int _popoverHeight = 0;
	private bool _popoverShowClose = true;
	private bool _popoverOpenOnClick = true;
	private bool _popoverDisabled = false;
	private bool _popoverCloseOutside = true;
	private bool _popoverCloseEsc = true;

	private ElementReference _popoverLog;
	private string _popoverLogMessage = "";

	private async Task OnPopoverOpen()
	{
		_popoverLogMessage += $"Popover opened. {Environment.NewLine}";
		await _popoverLog.ScrollToEndAsync();
	}

	private async Task OnPopoverClose()
	{
		_popoverLogMessage += $"Popover closed. {Environment.NewLine}";
		await _popoverLog.ScrollToEndAsync();
	}

	private async Task CloseColorPopover()
	{
		if (_colorPopover is not null)
		{
			await _colorPopover.CloseAsync();
		}
	}

	private async Task OnColorPicked(Color color)
	{
		//Only update the preview/log. The Popover stays open so the user can keep adjusting the color.
		_pickedColor = color;
		_popoverLogMessage += $"Color changed: {color.ToHtmlHex()}. {Environment.NewLine}";
		await _popoverLog.ScrollToEndAsync();
	}
}
